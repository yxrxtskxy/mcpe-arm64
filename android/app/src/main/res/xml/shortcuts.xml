<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: the launcher's library screen with the last run report and the
     diagnostic switches. targetPackage must match applicationId in app/build.gradle.kts. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="runtime_tools"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/runtime_tools">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.yxrxtskxy.mcpe.arm64"
            android:targetClass="com.zettabridge.launcher.LibraryActivity" />
    </shortcut>
</shortcuts>
