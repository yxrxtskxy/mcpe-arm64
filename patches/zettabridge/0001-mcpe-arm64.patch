+std::uint64_t read_virtual_count(void*, std::uint32_t, std::uint32_t) {
+#if defined(__aarch64__)
+    std::uint64_t value;
+    asm volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(value) : : "memory");
